# ===========================================================
# Crypto Strategy Lab — Backend environment variables (template)
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# ===========================================================

# Runtime
NODE_ENV=development
PORT=3000

# PostgreSQL (Supabase / local Postgres)
DATABASE_URL=

# Redis (BullMQ broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Binance public endpoints (no API key needed for public market data in MVP)
BINANCE_REST_BASE_URL=https://api.binance.com
BINANCE_WS_BASE_URL=wss://stream.binance.com:9443

# External news + sentiment providers (leave blank if not used yet)
CRYPTOPANIC_API_KEY=
GEMINI_API_KEY=

# CORS allowlist (comma-separated origins, "*" allows all)
CORS_ORIGINS=*